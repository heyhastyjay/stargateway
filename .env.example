# Server
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=http://10.0.0.1:8080
DATA_DIR=./data

# Admin login (change this)
ADMIN_PASSWORD=changeme

# Full Internet Access — members gate (Friday Dinner Head Playa Chef from kitchen sheet)
# Live answer is fetched from the sheet; MEMBERS_PASSWORD is fallback if offline.
MEMBERS_PASSWORD=Ladan
# MEMBERS_SHEET_ID=1xMS9to9eNmmhnzOncK-b5qdm1Na-Mzxg-mdSQBt-MYo
# MEMBERS_SHEET_GID=1827469735

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Firewall / network
# Set FIREWALL_ENABLED=false for local UI development without nftables
FIREWALL_ENABLED=true
LAN_INTERFACE=wlan0
WAN_INTERFACE=eth0
PORTAL_IP=10.0.0.1
PORTAL_PORT=8080

# Crowd-approved site whitelist (dnsmasq exceptions + nftables allowed_dests)
WHITELIST_UPSTREAM_DNS=8.8.8.8
# DNSMASQ_WHITELIST_CONF=/etc/dnsmasq.d/starlink-paywall-whitelist.conf
# DNSMASQ_BLOCKLIST_CONF=/etc/dnsmasq.d/starlink-paywall-block.conf

# Optional: simulate a client MAC when not behind the gateway (dev only)
# DEV_CLIENT_MAC=aa:bb:cc:dd:ee:ff

# Factory Wi‑Fi MACs that may set remaining Starlink data (comma-separated).
# Pixel 10 Pro is already seeded in code (b0:d5:fb:9c:1a:ef). Add your computer here
# or authorize it from /data by entering that phone MAC once.
# DATA_OPERATOR_IDS=b0:d5:fb:9c:1a:ef,aa:bb:cc:dd:ee:ff

# Optional: override weather/radar center (defaults = Black Rock City)
# WEATHER_LAT=40.7869
# WEATHER_LON=-119.2066
# WEATHER_TZ=America/Los_Angeles
# WEATHER_RADAR_TITLE=Black Rock City
